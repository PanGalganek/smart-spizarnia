rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function adminUid() {
      return "xFkLT9w6iWhSgzTyUy1QUj3d26R2";
    }

    function signedIn() {
      return request.auth != null;
    }

    function profilePath(uid) {
      return /databases/$(database)/documents/userProfiles/$(uid);
    }

    function existingProfile(uid) {
      return get(profilePath(uid)).data;
    }

    function isAdmin() {
      return signedIn()
        && (
          request.auth.uid == adminUid()
          || (
            exists(profilePath(request.auth.uid))
            && existingProfile(request.auth.uid).role == "admin"
            && existingProfile(request.auth.uid).status == "active"
          )
        );
    }

    function isActiveUser(uid) {
      return signedIn()
        && request.auth.uid == uid
        && exists(profilePath(uid))
        && existingProfile(uid).status == "active";
    }

    function canReadUserData(uid) {
      return isAdmin() || isActiveUser(uid);
    }

    function canWriteUserData(uid) {
      return isAdmin() || isActiveUser(uid);
    }

    function optionalString(data, field) {
      return !(field in data) || data[field] is string;
    }

    function optionalNumber(data, field) {
      return !(field in data) || data[field] is number || data[field] == null;
    }

    function optionalBool(data, field) {
      return !(field in data) || data[field] is bool;
    }

    function optionalList(data, field) {
      return !(field in data) || data[field] is list;
    }

    function optionalMap(data, field) {
      return !(field in data) || data[field] is map;
    }

    function isUnit(value) {
      return value in ["g", "ml", "szt"];
    }

    function validUserProfile(data) {
      return data.keys().hasOnly(["uid", "email", "displayName", "role", "status", "createdAt", "updatedAt"])
        && data.uid is string
        && data.email is string
        && data.role in ["admin", "user"]
        && data.status in ["pending", "active", "blocked"]
        && data.createdAt is number
        && data.updatedAt is number
        && optionalString(data, "displayName");
    }

    function validOwnPendingProfile(uid, data) {
      return validUserProfile(data)
        && data.uid == uid
        && data.role == "user"
        && data.status == "pending";
    }

    function validProduct(data) {
      return data.keys().hasOnly([
          "barcode", "name", "brand", "imageUrl", "servingSize",
          "netWeightGrams", "packageAmount", "packageUnit",
          "quickUseAmount", "quickUseUnit", "defaultUnit",
          "nutritionBasis", "nutrientsPer100g", "source", "type", "updatedAt"
        ])
        && data.barcode is string
        && data.name is string
        && data.nutrientsPer100g is map
        && data.source in ["open-food-facts", "usda", "manual"]
        && (!("type" in data) || data.type in ["food", "household_chemical"])
        && data.updatedAt is number
        && optionalString(data, "brand")
        && optionalString(data, "imageUrl")
        && optionalString(data, "servingSize")
        && optionalNumber(data, "netWeightGrams")
        && optionalNumber(data, "packageAmount")
        && (!("packageUnit" in data) || isUnit(data.packageUnit))
        && optionalNumber(data, "quickUseAmount")
        && (!("quickUseUnit" in data) || isUnit(data.quickUseUnit))
        && (!("defaultUnit" in data) || isUnit(data.defaultUnit))
        && (!("nutritionBasis" in data) || data.nutritionBasis in ["per100", "perUnit"]);
    }

    function validPantryItem(data) {
      return data.keys().hasOnly([
          "barcode", "product", "quantity", "capacity", "packages",
          "unit", "expiryDate", "location", "status", "chemicalLevel", "updatedAt"
        ])
        && data.barcode is string
        && data.product is map
        && data.quantity is number
        && isUnit(data.unit)
        && optionalNumber(data, "capacity")
        && optionalList(data, "packages")
        && optionalString(data, "expiryDate")
        && optionalString(data, "location")
        && (!("chemicalLevel" in data) || data.chemicalLevel in ["full", "more_than_half", "half", "less_than_half", "empty"])
        && (!("status" in data) || data.status in ["active", "consumed"])
        && optionalNumber(data, "updatedAt");
    }

    function validMeal(data) {
      return data.keys().hasOnly([
          "id", "name", "type", "ingredients", "servings",
          "recipeTotals", "totals", "dateKey", "createdAt",
          "consumerId", "consumerName"
        ])
        && data.id is string
        && data.name is string
        && data.type in ["breakfast", "lunch", "dinner", "snack", "custom"]
        && data.ingredients is list
        && data.totals is map
        && data.dateKey is string
        && data.createdAt is number
        && optionalNumber(data, "servings")
        && optionalMap(data, "recipeTotals")
        && optionalString(data, "consumerId")
        && optionalString(data, "consumerName");
    }

    function validDailySummary(data) {
      return data.keys().hasOnly([
          "dateKey", "totals", "mealCount", "updatedAt",
          "consumerId", "consumerName"
        ])
        && data.dateKey is string
        && data.totals is map
        && data.mealCount is number
        && data.updatedAt is number
        && optionalString(data, "consumerId")
        && optionalString(data, "consumerName");
    }

    function validShoppingItem(data) {
      return data.keys().hasOnly([
          "id", "name", "productBarcode", "product", "source",
          "status", "createdAt", "updatedAt", "purchasedAt"
        ])
        && data.id is string
        && data.name is string
        && data.source in ["depleted", "saved", "manual"]
        && data.status in ["active", "purchased"]
        && data.createdAt is number
        && data.updatedAt is number
        && optionalString(data, "productBarcode")
        && optionalMap(data, "product")
        && optionalNumber(data, "purchasedAt");
    }

    function validConsumer(data) {
      return data.keys().hasOnly(["id", "name", "protected"])
        && data.id is string
        && data.name is string
        && optionalBool(data, "protected");
    }

    function validHydrationSettings(data) {
      return data.keys().hasOnly([
          "id", "consumerId", "consumerName", "dailyGoalMl",
          "remindersEnabled", "reminderIntervalMinutes", "reminderStartHour",
          "reminderEndHour", "lastReminderAt", "updatedAt"
        ])
        && data.id is string
        && data.consumerId is string
        && data.consumerName is string
        && data.dailyGoalMl is number
        && data.dailyGoalMl >= 250
        && data.dailyGoalMl <= 10000
        && data.remindersEnabled is bool
        && data.reminderIntervalMinutes is number
        && data.reminderIntervalMinutes >= 30
        && data.reminderIntervalMinutes <= 720
        && data.reminderStartHour is number
        && data.reminderStartHour >= 0
        && data.reminderStartHour <= 23
        && data.reminderEndHour is number
        && data.reminderEndHour >= 1
        && data.reminderEndHour <= 24
        && optionalNumber(data, "lastReminderAt")
        && data.updatedAt is number;
    }

    function validHydrationEntry(data) {
      return data.keys().hasOnly(["id", "consumerId", "consumerName", "amountMl", "dateKey", "createdAt"])
        && data.id is string
        && data.consumerId is string
        && data.consumerName is string
        && data.amountMl is number
        && data.amountMl > 0
        && data.amountMl <= 3000
        && data.dateKey is string
        && data.createdAt is number;
    }

    function validHydrationDaily(data) {
      return data.keys().hasOnly(["id", "consumerId", "consumerName", "dateKey", "totalMl", "goalMl", "entryCount", "updatedAt"])
        && data.id is string
        && data.consumerId is string
        && data.consumerName is string
        && data.dateKey is string
        && data.totalMl is number
        && data.totalMl >= 0
        && data.goalMl is number
        && data.goalMl >= 250
        && data.goalMl <= 10000
        && data.entryCount is number
        && data.entryCount >= 0
        && data.updatedAt is number;
    }

    function validPushSubscription(data) {
      return data.keys().hasOnly(["id", "endpoint", "p256dh", "auth", "enabled", "userAgent", "createdAt", "updatedAt"])
        && data.id is string
        && data.endpoint is string
        && data.p256dh is string
        && data.auth is string
        && data.enabled is bool
        && optionalString(data, "userAgent")
        && data.createdAt is number
        && data.updatedAt is number;
    }

    function validSettings(settingsId, data) {
      return settingsId in ["storageLocations", "storageLocations_household_chemical", "legacyRootMigration_v1"]
        && data.keys().hasOnly(["values", "updatedAt", "type"])
        && data.values is list
        && data.updatedAt is number
        && (!("type" in data) || data.type in ["food", "household_chemical"]);
    }

    match /userProfiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn()
        && (
          (request.auth.uid == uid && validOwnPendingProfile(uid, request.resource.data))
          || (isAdmin() && validUserProfile(request.resource.data))
          || (request.auth.uid == adminUid() && uid == adminUid() && validUserProfile(request.resource.data))
        );
      allow update: if isAdmin() && validUserProfile(request.resource.data);
      allow delete: if isAdmin() && uid != request.auth.uid;
    }

    match /users/{userId}/products/{barcode} {
      allow read, delete: if canReadUserData(userId);
      allow create, update: if canWriteUserData(userId) && validProduct(request.resource.data);
    }

    match /users/{userId}/pantry/{barcode} {
      allow read, delete: if canReadUserData(userId);
      allow create, update: if canWriteUserData(userId) && validPantryItem(request.resource.data);
    }

    match /users/{userId}/meals/{mealId} {
      allow read, delete: if canReadUserData(userId);
      allow create, update: if canWriteUserData(userId) && validMeal(request.resource.data);
    }

    match /users/{userId}/dailySummaries/{summaryId} {
      allow read, delete: if canReadUserData(userId);
      allow create, update: if canWriteUserData(userId) && validDailySummary(request.resource.data);
    }

    match /users/{userId}/shoppingList/{itemId} {
      allow read, delete: if canReadUserData(userId);
      allow create, update: if canWriteUserData(userId) && validShoppingItem(request.resource.data);
    }

    match /users/{userId}/consumers/{consumerId} {
      allow read, delete: if canReadUserData(userId);
      allow create, update: if canWriteUserData(userId) && validConsumer(request.resource.data);
    }

    match /users/{userId}/settings/{settingsId} {
      allow read, delete: if canReadUserData(userId);
      allow create, update: if canWriteUserData(userId) && validSettings(settingsId, request.resource.data);
    }

    match /users/{userId}/hydrationSettings/{settingsId} {
      allow read, delete: if canReadUserData(userId);
      allow create, update: if canWriteUserData(userId) && validHydrationSettings(request.resource.data);
    }

    match /users/{userId}/hydrationEntries/{entryId} {
      allow read, delete: if canReadUserData(userId);
      allow create, update: if canWriteUserData(userId) && validHydrationEntry(request.resource.data);
    }

    match /users/{userId}/hydrationDaily/{summaryId} {
      allow read, delete: if canReadUserData(userId);
      allow create, update: if canWriteUserData(userId) && validHydrationDaily(request.resource.data);
    }

    match /users/{userId}/pushSubscriptions/{subscriptionId} {
      allow read, delete: if canReadUserData(userId);
      allow create, update: if canWriteUserData(userId) && validPushSubscription(request.resource.data);
    }

    match /products/{documentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /pantry/{documentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /meals/{documentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /dailySummaries/{documentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /shoppingList/{documentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /consumers/{documentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /settings/{documentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
