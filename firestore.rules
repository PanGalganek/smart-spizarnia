rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function adminUid() {
      return "xFkLT9w6iWhSgzTyUy1QUj3d26R2";
    }

    function signedIn() {
      return request.auth != null;
    }

    function profilePath(uid) {
      return /databases/$(database)/documents/userProfiles/$(uid);
    }

    function existingProfile(uid) {
      return get(profilePath(uid)).data;
    }

    function isAdmin() {
      return signedIn()
        && exists(profilePath(request.auth.uid))
        && existingProfile(request.auth.uid).role == "admin"
        && existingProfile(request.auth.uid).status == "active";
    }

    function isActiveUser(uid) {
      return signedIn()
        && request.auth.uid == uid
        && exists(profilePath(uid))
        && existingProfile(uid).status == "active";
    }

    function canReadUserData(uid) {
      return isAdmin() || isActiveUser(uid);
    }

    function canWriteUserData(uid) {
      return isAdmin() || isActiveUser(uid);
    }

    function optionalString(data, field) {
      return !(field in data) || (data[field] is string && data[field].size() <= 2000);
    }

    function nonNegativeNumber(value) {
      return value is number && value >= 0 && value <= 1000000000000;
    }

    function validTime(value) {
      return value is int && value >= 0 && value <= 8640000000000000;
    }

    function validName(value) {
      return value is string && value.size() > 0 && value.size() <= 200;
    }

    function validDate(value) {
      return value is string && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }

    function optionalTime(data, field) {
      return !(field in data) || data[field] == null || validTime(data[field]);
    }

    function optionalNumber(data, field) {
      return !(field in data) || data[field] == null || nonNegativeNumber(data[field]);
    }

    function optionalBool(data, field) {
      return !(field in data) || data[field] is bool;
    }

    function optionalList(data, field) {
      // Bounds the container only. Per-entry and cross-document business
      // invariants remain application-side; see README's protection scope.
      return !(field in data) || (data[field] is list && data[field].size() <= 1000);
    }

    function optionalMap(data, field) {
      return !(field in data) || data[field] is map;
    }

    function isUnit(value) {
      return value in ["g", "ml", "szt"];
    }

    function validNutrients(data) {
      return data is map
        && data.keys().hasOnly(["energyKcal", "proteins", "carbohydrates", "fat", "fiber", "salt", "sodium", "potassium", "calcium", "iron", "magnesium", "vitaminC", "vitaminA"])
        && validNutrient(data, "energyKcal") && validNutrient(data, "proteins")
        && validNutrient(data, "carbohydrates") && validNutrient(data, "fat")
        && validNutrient(data, "fiber") && validNutrient(data, "salt")
        && validNutrient(data, "sodium") && validNutrient(data, "potassium")
        && validNutrient(data, "calcium") && validNutrient(data, "iron")
        && validNutrient(data, "magnesium") && validNutrient(data, "vitaminC")
        && validNutrient(data, "vitaminA");
    }

    function validNutrient(data, field) {
      return !(field in data) || nonNegativeNumber(data[field]);
    }

    function validServings(data) {
      return !("servings" in data) || (data.servings is int && data.servings >= 1 && data.servings <= 100);
    }

    function validUserProfile(data) {
      return data.keys().hasOnly(["uid", "email", "displayName", "role", "status", "createdAt", "updatedAt"])
        && validName(data.uid)
        && data.email is string
        && data.role in ["admin", "user"]
        && data.status in ["pending", "active", "blocked"]
        && validTime(data.createdAt)
        && validTime(data.updatedAt)
        && optionalString(data, "displayName");
    }

    function validOwnPendingProfile(uid, data) {
      return validUserProfile(data)
        && data.uid == uid
        && data.email == request.auth.token.get("email", "")
        && data.role == "user"
        && data.status == "pending";
    }

    function validProduct(data) {
      return data.keys().hasOnly([
          "barcode", "name", "brand", "imageUrl", "servingSize",
          "netWeightGrams", "packageAmount", "packageUnit",
          "quickUseAmount", "quickUseUnit", "defaultUnit",
          "nutritionBasis", "nutrientsPer100g", "source", "type", "updatedAt"
        ])
        && validName(data.barcode)
        && validName(data.name)
        && validNutrients(data.nutrientsPer100g)
        && data.source in ["open-food-facts", "usda", "manual"]
        && (!("type" in data) || data.type in ["food", "household_chemical"])
        && validTime(data.updatedAt)
        && optionalString(data, "brand")
        && optionalString(data, "imageUrl")
        && optionalString(data, "servingSize")
        && optionalNumber(data, "netWeightGrams")
        && optionalNumber(data, "packageAmount")
        && (!("packageUnit" in data) || isUnit(data.packageUnit))
        && optionalNumber(data, "quickUseAmount")
        && (!("quickUseUnit" in data) || isUnit(data.quickUseUnit))
        && (!("defaultUnit" in data) || isUnit(data.defaultUnit))
        && (!("nutritionBasis" in data) || data.nutritionBasis in ["per100", "perUnit"]);
    }

    function validPantryItem(data) {
      return data.keys().hasOnly([
          "barcode", "product", "quantity", "capacity", "packages",
          "unit", "expiryDate", "location", "status", "chemicalLevel", "updatedAt"
        ])
        && validName(data.barcode)
        && validProduct(data.product)
        && data.product.barcode == data.barcode
        && nonNegativeNumber(data.quantity)
        && isUnit(data.unit)
        && optionalNumber(data, "capacity")
        && (!("capacity" in data) || data.capacity == null || data.capacity >= data.quantity)
        && optionalList(data, "packages")
        && (!("expiryDate" in data) || validDate(data.expiryDate))
        && optionalString(data, "location")
        && (!("chemicalLevel" in data) || data.chemicalLevel in ["full", "more_than_half", "half", "less_than_half", "empty"])
        && (!("status" in data) || data.status in ["active", "consumed"])
        && (!("status" in data) || data.status != "consumed" || data.quantity == 0)
        && optionalTime(data, "updatedAt");
    }

    function validMeal(data) {
      return data.keys().hasOnly([
          "id", "name", "type", "ingredients", "servings",
          "recipeTotals", "totals", "dateKey", "createdAt",
          "consumerId", "consumerName"
        ])
        && validName(data.id)
        && validName(data.name)
        && data.type in ["breakfast", "lunch", "dinner", "snack", "custom"]
        && data.ingredients is list
        && data.ingredients.size() > 0 && data.ingredients.size() <= 50
        && validNutrients(data.totals)
        && validDate(data.dateKey)
        && validTime(data.createdAt)
        && validServings(data)
        && (!("recipeTotals" in data) || validNutrients(data.recipeTotals))
        && optionalString(data, "consumerId")
        && optionalString(data, "consumerName");
    }

    function validDailySummary(data) {
      return data.keys().hasOnly([
          "dateKey", "totals", "mealCount", "updatedAt",
          "consumerId", "consumerName"
        ])
        && validDate(data.dateKey)
        && validNutrients(data.totals)
        && data.mealCount is int && data.mealCount >= 0 && data.mealCount <= 1000000
        && validTime(data.updatedAt)
        && optionalString(data, "consumerId")
        && optionalString(data, "consumerName");
    }

    function validMealTemplate(data) {
      return data.keys().hasOnly(["id", "name", "type", "ingredients", "servings", "createdAt", "updatedAt"])
        && validName(data.id)
        && validName(data.name)
        && data.type in ["breakfast", "lunch", "dinner", "snack", "custom"]
        && data.ingredients is list
        && data.ingredients.size() > 0
        && data.ingredients.size() <= 50
        && data.servings is int
        && data.servings >= 1
        && data.servings <= 100
        && validTime(data.createdAt)
        && validTime(data.updatedAt);
    }

    function validShoppingItem(data) {
      return data.keys().hasOnly([
          "id", "name", "productBarcode", "product", "source",
          "status", "createdAt", "updatedAt", "purchasedAt"
        ])
        && validName(data.id)
        && validName(data.name)
        && data.source in ["depleted", "saved", "manual"]
        && data.status in ["active", "purchased"]
        && validTime(data.createdAt)
        && validTime(data.updatedAt)
        && optionalString(data, "productBarcode")
        && optionalMap(data, "product")
        && (!("product" in data) || (validProduct(data.product) && data.productBarcode == data.product.barcode))
        && optionalTime(data, "purchasedAt");
    }

    function validConsumer(data) {
      return data.keys().hasOnly(["id", "name", "protected"])
        && validName(data.id)
        && validName(data.name)
        && optionalBool(data, "protected");
    }

    function validSettings(settingsId, data) {
      return settingsId in ["storageLocations", "storageLocations_household_chemical", "legacyRootMigration_v1"]
        && data.keys().hasOnly(["values", "updatedAt", "type"])
        && data.values is list
        && data.values.size() <= 100
        && validTime(data.updatedAt)
        && (!("type" in data) || data.type in ["food", "household_chemical"]);
    }

    match /userProfiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn()
        && (
          (request.auth.uid == uid && validOwnPendingProfile(uid, request.resource.data))
          || (isAdmin() && validUserProfile(request.resource.data) && request.resource.data.uid == uid)
          // Bootstrap applies only to create, never to an existing blocked profile.
          || (request.auth.uid == adminUid() && uid == adminUid()
            && validUserProfile(request.resource.data) && request.resource.data.uid == uid
            && request.resource.data.role == "admin" && request.resource.data.status == "active")
        );
      allow update: if isAdmin() && validUserProfile(request.resource.data) && request.resource.data.uid == uid;
      allow delete: if isAdmin() && uid != request.auth.uid && uid != adminUid();
    }

    match /users/{userId}/products/{barcode} {
      allow read, delete: if canReadUserData(userId);
      allow create, update: if canWriteUserData(userId) && validProduct(request.resource.data) && request.resource.data.barcode == barcode;
    }

    match /users/{userId}/pantry/{barcode} {
      allow read, delete: if canReadUserData(userId);
      allow create, update: if canWriteUserData(userId) && validPantryItem(request.resource.data) && request.resource.data.barcode == barcode;
    }

    match /users/{userId}/meals/{mealId} {
      allow read, delete: if canReadUserData(userId);
      allow create, update: if canWriteUserData(userId) && validMeal(request.resource.data) && request.resource.data.id == mealId;
    }

    match /users/{userId}/dailySummaries/{summaryId} {
      allow read, delete: if canReadUserData(userId);
      allow create, update: if canWriteUserData(userId) && validDailySummary(request.resource.data)
        && (summaryId == request.resource.data.dateKey + "__" + request.resource.data.get("consumerId", "legacy")
          || (!("consumerId" in request.resource.data) && summaryId == request.resource.data.dateKey));
    }

    match /users/{userId}/mealTemplates/{templateId} {
      allow read, delete: if canReadUserData(userId);
      allow create, update: if canWriteUserData(userId) && validMealTemplate(request.resource.data) && request.resource.data.id == templateId;
    }

    match /users/{userId}/shoppingList/{itemId} {
      allow read, delete: if canReadUserData(userId);
      allow create, update: if canWriteUserData(userId) && validShoppingItem(request.resource.data) && request.resource.data.id == itemId;
    }

    match /users/{userId}/consumers/{consumerId} {
      allow read: if canReadUserData(userId);
      allow delete: if canWriteUserData(userId) && (isAdmin() || !resource.data.get("protected", false));
      allow create: if canWriteUserData(userId) && validConsumer(request.resource.data) && request.resource.data.id == consumerId;
      allow update: if canWriteUserData(userId) && validConsumer(request.resource.data) && request.resource.data.id == consumerId
        && (isAdmin() || !resource.data.get("protected", false) || request.resource.data.get("protected", false));
    }

    match /users/{userId}/settings/{settingsId} {
      allow read, delete: if canReadUserData(userId);
      allow create, update: if canWriteUserData(userId) && validSettings(settingsId, request.resource.data);
    }

    match /products/{documentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /pantry/{documentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /meals/{documentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /dailySummaries/{documentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /shoppingList/{documentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /consumers/{documentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /settings/{documentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
