{
  "expo": {
    "name": "Smart Spizarnia",
    "slug": "smart-spizarnia",
    "version": "0.3.0",
    "orientation": "default",
    "scheme": "smartspizarnia",
    "userInterfaceStyle": "light",
    "web": {
      "output": "static"
    },
    "experiments": {
      "baseUrl": "/smart-spizarnia"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Aplikacja potrzebuje aparatu do skanowania kodow kreskowych.",
          "barcodeScannerEnabled": true,
          "recordAudioAndroid": false
        }
      ],
      "expo-asset"
    ],
    "android": {
      "package": "pl.smartspizarnia.app",
      "permissions": [
        "CAMERA"
      ]
    },
    "ios": {
      "bundleIdentifier": "pl.smartspizarnia.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Aplikacja potrzebuje aparatu do skanowania kodow kreskowych."
      }
    }
  }
}
