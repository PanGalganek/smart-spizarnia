{
  "expo": {
    "name": "Smart Spiżarnia",
    "slug": "smart-spizarnia",
    "version": "0.11.24",
    "orientation": "default",
    "scheme": "smartspizarnia",
    "userInterfaceStyle": "light",
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "baseUrl": "/smart-spizarnia"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Aplikacja potrzebuje aparatu do skanowania kodów kreskowych.",
          "barcodeScannerEnabled": true,
          "recordAudioAndroid": false
        }
      ],
      "expo-asset"
    ],
    "android": {
      "package": "pl.smartspizarnia.app",
      "permissions": [
        "CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F0DE"
      }
    },
    "ios": {
      "bundleIdentifier": "pl.smartspizarnia.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Aplikacja potrzebuje aparatu do skanowania kodów kreskowych."
      },
      "icon": "./assets/icon.png"
    },
    "icon": "./assets/icon.png"
  }
}
